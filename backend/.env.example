# Backend Port
PORT=5000

# MongoDB Connection String (Prefer Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/flexion-ai?retryWrites=true&w=majority

# JWT Token Secret
JWT_SECRET=super_secret_jwt_sign_key_for_flexion_ai

# Internal Service API Secret
AI_SERVICE_KEY=pre_shared_secret_api_key_for_fastapi_communication

# Node Environment
NODE_ENV=development
