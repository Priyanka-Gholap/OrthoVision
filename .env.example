# ==========================================
# Flexion AI - Global Environment variables
# ==========================================

# Backend Settings
BACKEND_PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/flexion-ai?retryWrites=true&w=majority
JWT_SECRET=super_secret_jwt_sign_key_for_flexion_ai
AI_SERVICE_KEY=pre_shared_secret_api_key_for_fastapi_communication

# Frontend Settings
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_AI_URL=http://localhost:8000/ai
NEXT_PUBLIC_LANDMARK_CONFIDENCE_THRESHOLD=0.5

# AI Service Settings
AI_PORT=8000
AI_SERVICE_KEY=pre_shared_secret_api_key_for_fastapi_communication
